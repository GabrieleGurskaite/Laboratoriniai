%pagrindines uzduoties 12 variantas
clc; clear; close all;

%% Pradiniai duomenys
xPrad    = -pi;
xPab     =  pi;
zingsnis =  0.1;
storis   =  5;
vardikl  =  4;

x = xPrad : zingsnis : xPab;
if abs(x(end) - xPab) > eps
    x(end+1) = xPab;
end

zymPad = min(x) : pi/vardikl : max(x);
kartot = round(zymPad / (pi/vardikl));
zymUzr = piZymos(kartot, vardikl);

%% 1 a)
y1 = sin(x);

figure('Color','w');
plot(x, y1, '-', 'LineWidth', 2, 'Color', [0.00 0.45 0.74]);
grid on;
axis([min(x) max(x) min(y1) max(y1)]);
set(gca, 'XTick', zymPad, 'XTickLabel', zymUzr, 'FontSize', 11);

xlabel('x asis, rad');
ylabel('f(x) reiksme');
title('f(x) = sin(x), x \in [-\pi, \pi]');
legend('f(x) = sin(x)', 'Location', 'northeastoutside');

%% 1 b)
Y = [2*sin(x).*cos(x); 3*sin(x).*cos(x)];

figure('Color','w');
plot(x, Y(1,:), '-',  'LineWidth', storis, 'Color', [0.85 0.33 0.10]);
hold on;
plot(x, Y(2,:), '--', 'LineWidth', storis, 'Color', [0.47 0.67 0.19]);
hold off;
grid on;
axis([min(x) max(x) min(Y(:)) max(Y(:))]);
set(gca, 'XTick', zymPad, 'XTickLabel', zymUzr, 'FontSize', 11);

xlabel('x asis, rad');
ylabel('f(x) reiksme');
title('f(x) = 2sin(x)cos(x) ir f(x) = 3sin(x)cos(x)');
legend({'f(x) = 2sin(x)cos(x)', 'f(x) = 3sin(x)cos(x)'}, ...
       'Location', 'northeastoutside');

%% 2 a)
t  = 0 : pi/20 : 4*pi;
xt = sin(t);
yt = cos(t);
zt = tan(t);

riba = 10;
zt(abs(zt) > riba) = NaN;

figure('Color','w');
plot3(xt, yt, zt, '-o', 'LineWidth', 1.5, 'Color', [0.49 0.18 0.56], ...
      'MarkerSize', 5, 'MarkerEdgeColor', [0.49 0.18 0.56], 'MarkerFaceColor', 'w');
grid on;
axis([-1 1 -1 1 -riba riba]);
view(-37.5, 30);

xlabel('x(t) = sin(t)');
ylabel('y(t) = cos(t)');
zlabel('z(t) = tan(t)');
title('x = sin(t), y = cos(t), z = tan(t), t \in [0, 4\pi]');
legend('erdvine kreive', 'Location', 'northeastoutside');

%%
function zymos = piZymos(k, d0)
    zymos = cell(1, numel(k));
    for i = 1:numel(k)
        n = k(i);
        d = d0;
        if n == 0
            zymos{i} = '0';
            continue
        end
        g = gcd(abs(n), d);
        n = n / g;
        d = d / g;
        if n < 0
            zenklas = '-';
            n = -n;
        else
            zenklas = '';
        end
        if n == 1
            skaitiklis = '\pi';
        else
            skaitiklis = sprintf('%d\\pi', n);
        end
        if d == 1
            zymos{i} = [zenklas skaitiklis];
        else
            zymos{i} = sprintf('%s%s/%d', zenklas, skaitiklis, d);
        end
    end
end

%papildomos uzduoties 15 variantas

clc; clear; close all;

%% 2-ojo LD 3 uzduoties duomenys
rng(42)
Amp = 6; f = 2; sigma = 1.5; U1 = 4; U2 = 2;

t = 0:0.005:2;
s = Amp*cos(2*pi*f*t);
n = sigma*randn(size(t));
x = s + n;

xf = x;
xf(abs(xf) < U2) = 0;

virsIdx = find(x > U1);
virsT   = t(virsIdx);
virsU1  = x(virsIdx);

figure('Color', 'w', 'Position', [80 200 1150 430]);

%% P a) Pradinis ir filtruotas signalas
subplot(1, 2, 1);

hPrad = plot(t, x,  '--', 'LineWidth', 1.00, 'Color', [0.00 0.45 0.74]);
hold on;
hFilt = plot(t, xf, '-',  'LineWidth', 1.25, 'Color', [0.85 0.33 0.10]);

hU1 = yline( U1, '-.', 'LineWidth', 1.5, 'Color', [0.49 0.18 0.56]);
hU2 = yline( U2, '-.', 'LineWidth', 1.5, 'Color', [1 1 0]);
yline(-U2, '-.', 'LineWidth', 1.5, 'Color', [1 1 0]);
hold off;

grid on;
visosY = [x, xf, U1, U2, -U2];
atsarga = 0.05 * (max(visosY) - min(visosY));
axis([min(t) max(t) min(visosY)-atsarga max(visosY)+atsarga]);

xlabel('Laikas t, s');
ylabel('Itampa, V');
title('Pradinis ir filtruotas signalas', 'FontWeight', 'bold', 'FontSize', 11);
legend([hPrad hFilt hU1 hU2], ...
    {'Pradinis signalas x(t)', 'Filtruotas signalas x_f(t)', ...
    'Riba U_1 = 4 V', 'Ribos \pmU_2 = \pm2 V'}, ...
    'Location', 'southoutside');

%% P b) Diskretus vaizdavimas ir ekstremumu zymekliai
subplot(1, 2, 2);

hStem = stem(virsT, virsU1, 'filled', 'LineWidth', 1, ...
    'Color', [0.00 0.45 0.74], 'MarkerSize', 4);
hold on;

maxIdx = find(virsU1 == max(virsU1));
minIdx = find(virsU1 == min(virsU1));

hMax = plot(virsT(maxIdx), virsU1(maxIdx), 's', 'LineStyle', 'none', ...
    'MarkerSize', 9, 'MarkerEdgeColor', [0 1 1], 'MarkerFaceColor', [0 1 1]);
hMin = plot(virsT(minIdx), virsU1(minIdx), 'v', 'LineStyle', 'none', ...
    'MarkerSize', 9, 'MarkerEdgeColor', [1 0 1], 'MarkerFaceColor', [1 0 1]);
hold off;

grid on;
axis([min(t) max(t) 0 max(virsU1)*1.1]);

xlabel('Laikas t, s');
ylabel('Itampa, V');
title('Reiksmes, virsijancios riba U_1', 'FontWeight', 'bold', 'FontSize', 11);
legend([hStem hMax hMin], ...
    {'x(t) > U_1', 'Maksimali reiksme', 'Minimali reiksme'}, ...
    'Location', 'southoutside');
