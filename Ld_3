%pagrindines uzduoties 12 variantas
clc; clear; close all;

%% Pradiniai duomenys
xPrad    = -pi;
xPab     =  pi;
zingsnis =  0.1;
storis   =  5;
vardikl  =  4;

x = xPrad : zingsnis : xPab;
if abs(x(end) - xPab) > eps
    x(end+1) = xPab;
end

zymPad = min(x) : pi/vardikl : max(x);
kartot = round(zymPad / (pi/vardikl));
zymUzr = piZymos(kartot, vardikl);

%% 1 a)
y1 = sin(x);

figure('Color','w');
plot(x, y1, '-', 'LineWidth', 2, 'Color', [0.00 0.45 0.74]);
grid on;
axis([min(x) max(x) min(y1) max(y1)]);
set(gca, 'XTick', zymPad, 'XTickLabel', zymUzr, 'FontSize', 11);

xlabel('x asis, rad');
ylabel('f(x) reiksme');
title('f(x) = sin(x), x \in [-\pi, \pi]');
legend('f(x) = sin(x)', 'Location', 'northeastoutside');

%% 1 b)
Y = [2*sin(x).*cos(x); 3*sin(x).*cos(x)];

figure('Color','w');
plot(x, Y(1,:), '-',  'LineWidth', storis, 'Color', [0.85 0.33 0.10]);
hold on;
plot(x, Y(2,:), '--', 'LineWidth', storis, 'Color', [0.47 0.67 0.19]);
hold off;
grid on;
axis([min(x) max(x) min(Y(:)) max(Y(:))]);
set(gca, 'XTick', zymPad, 'XTickLabel', zymUzr, 'FontSize', 11);

xlabel('x asis, rad');
ylabel('f(x) reiksme');
title('f(x) = 2sin(x)cos(x) ir f(x) = 3sin(x)cos(x)');
legend({'f(x) = 2sin(x)cos(x)', 'f(x) = 3sin(x)cos(x)'}, ...
       'Location', 'northeastoutside');

%% 2 a)
t  = 0 : pi/20 : 4*pi;
xt = sin(t);
yt = cos(t);
zt = tan(t);

riba = 10;
zt(abs(zt) > riba) = NaN;

figure('Color','w');
plot3(xt, yt, zt, '-o', 'LineWidth', 1.5, 'Color', [0.49 0.18 0.56], ...
      'MarkerSize', 5, 'MarkerEdgeColor', [0.49 0.18 0.56], 'MarkerFaceColor', 'w');
grid on;
axis([-1 1 -1 1 -riba riba]);
view(-37.5, 30);

xlabel('x(t) = sin(t)');
ylabel('y(t) = cos(t)');
zlabel('z(t) = tan(t)');
title('x = sin(t), y = cos(t), z = tan(t), t \in [0, 4\pi]');
legend('erdvine kreive', 'Location', 'northeastoutside');

%%
function zymos = piZymos(k, d0)
    zymos = cell(1, numel(k));
    for i = 1:numel(k)
        n = k(i);
        d = d0;
        if n == 0
            zymos{i} = '0';
            continue
        end
        g = gcd(abs(n), d);
        n = n / g;
        d = d / g;
        if n < 0
            zenklas = '-';
            n = -n;
        else
            zenklas = '';
        end
        if n == 1
            skaitiklis = '\pi';
        else
            skaitiklis = sprintf('%d\\pi', n);
        end
        if d == 1
            zymos{i} = [zenklas skaitiklis];
        else
            zymos{i} = sprintf('%s%s/%d', zenklas, skaitiklis, d);
        end
    end
end
