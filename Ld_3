legend('kreive', 'Location', 'best');

%%
function zymos = piZymos(k, d0)
zymos = cell(1, numel(k));
for i = 1:numel(k)
    n = k(i);
    d = d0;
    if n == 0
        zymos{i} = '0';
        continue
    end
    g = gcd(abs(n), d);
    n = n / g;
    d = d / g;
    if n < 0
        zenklas = '-';
        n = -n;
    else
        zenklas = '';
    end
    if n == 1
        skaitiklis = '\pi';
    else
        skaitiklis = sprintf('%d\\pi', n);
    end
    if d == 1
        zymos{i} = [zenklas skaitiklis];
    else
        zymos{i} = sprintf('%s%s/%d', zenklas, skaitiklis, d);
    end
end
end
