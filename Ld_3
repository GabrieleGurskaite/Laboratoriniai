% privalomos uzduoties 12 variantas
%% 1 a)
x = -pi:0.1:pi;
if abs(x(end) - pi) > eps
    x(end+1) = pi;
end

y1 = sin(x);

figure('Color','w');
plot(x, y1, '-', 'LineWidth', 2, 'Color', [0.00 0.45 0.74]);
grid on;
axis([min(x) max(x) min(y1) max(y1)]);

zymPad = min(x) : pi/4 : max(x);
kartot = round(zymPad / (pi/4));
set(gca, 'XTick', zymPad, 'XTickLabel', piZymos(kartot, 4), 'FontSize', 11);

xlabel('x asis, rad');
ylabel('f(x) reiksme');
title('f(x) = sin(x), x \in [-\pi, \pi]');
legend('f(x) = sin(x)', 'Location', 'best');

%% 1 b)
Y = [2*sin(x).*cos(x); 3*sin(x).*cos(x)];

figure('Color','w');
plot(x, Y(1,:), '-',  'LineWidth', 5, 'Color', [0.85 0.33 0.10]);
hold on;
plot(x, Y(2,:), '--', 'LineWidth', 5, 'Color', [0.47 0.67 0.19]);
hold off;
grid on;
axis([min(x) max(x) min(Y(:)) max(Y(:))]);
set(gca, 'XTick', zymPad, 'XTickLabel', piZymos(kartot, 4), 'FontSize', 11);

xlabel('x asis, rad');
ylabel('f(x) reiksme');
title('f(x) = 2sin(x)cos(x) ir f(x) = 3sin(x)cos(x)');
legend({'f(x) = 2sin(x)cos(x)', 'f(x) = 3sin(x)cos(x)'}, 'Location', 'best');

