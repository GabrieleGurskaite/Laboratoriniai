% pagrindinės užduoties 11 variantas
clc; clear; close all;

figure('Name', 'LD4 - 11 variantas');

%% a) f(x,y) = 1 - 2x^2 - 3y^2, kai x = r*cos(theta), y = r*sin(theta)
clc; clear; close all;

%% a dalis
n_theta  = 60;
n_r      = 30;
kampas_a = 50;

theta = linspace(0, 2*pi, n_theta);
r     = linspace(0, 1, n_r);
[R, T] = meshgrid(r, theta);
Xa = R .* cos(T);
Ya = R .* sin(T);
Za = 1 - 2*Xa.^2 - 3*Ya.^2;

figure('Name', 'a dalis');
ha = surf(Xa, Ya, Za);
colormap(jet);
shading interp;
rotate(ha, [0 0 1], kampas_a);
xlabel('x'); ylabel('y'); zlabel('f(x,y)');
title('a) f(x,y) = 1 - 2x^2 - 3y^2');
grid on; axis tight;

%% b dalis
n_rand   = 200;
kampas_b = 30;

x = sort((2*rand(1, n_rand) - 1) .* sqrt(pi/2));
y = sort((2*rand(1, n_rand) - 1) .* sqrt(pi/2));
[Xb, Yb] = meshgrid(x, y);
Zb = sin(Xb.^2 + Yb.^2);

figure('Name', 'b dalis');
hb = surf(Xb, Yb, Zb);
colormap(jet);
shading interp;
rotate(hb, [0 0 1], kampas_b);
xlabel('x'); ylabel('y'); zlabel('f(x,y)');
title('b) f(x,y) = sin(x^2 + y^2)');
grid on; axis tight;

%% Papildomos 12 variantas

n = 50;
riba = 1;
spalvos = {'parula', 'hot', 'cool'};

[X, Y] = meshgrid(linspace(-riba, riba, n));
Z = 1 - (X.^2 + Y.^2);

figure('Name', 'Papildoma uzduotis - colormap');
for k = 1:numel(spalvos)
    ax = subplot(1, numel(spalvos), k);
    surf(X, Y, Z);
    colormap(ax, spalvos{k});
    colorbar;
    shading interp;
    xlabel('x'); ylabel('y'); zlabel('z(x,y)');
    title(['colormap: ', spalvos{k}]);
    grid on; axis tight;
end
sgtitle('z(x,y) = 1 - (x^2 + y^2)');
